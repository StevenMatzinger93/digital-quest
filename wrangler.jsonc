{
  // Cloudflare Worker fuer Digital Quest: liefert den Ordner web/ als Website aus (statische Dateien direkt durch Cloudflare)
  // und beantwortet unter /api/… Konten, Klassen, Zuweisungen und Fortschritt (worker/index.js, docs/PLAN_KLASSEN_ZUWEISUNG.md).
  "name": "digital-quest",
  "compatibility_date": "2025-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS"
  },
  // Datenbank fuer Konten, Klassen, Zuweisungen und Fortschritt: EIGENE D1-Datenbank (nicht die von SCL Quest),
  // angelegt am 29.09.2026 (npx wrangler d1 create digitalquest, Region EEUR). Schema: migrations/ (wrangler d1 migrations apply).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digitalquest",
      "database_id": "04e24744-b4ae-4d58-a6bf-0e5b0e71e94a"
    }
  ]
  // Secrets (nicht in dieser Datei!): npx wrangler secret put ADMIN_USER / ADMIN_PASSWORD – im Projektordner ausfuehren
}
