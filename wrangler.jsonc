{
  // Cloudflare Worker fuer Digital Quest (Aufbau wie SPS Quest): liefert den Ordner web/ als Website aus,
  // /api/* beantwortet der Worker (worker/index.js) mit der Datenbank D1. Plan: docs/PLAN_PORTAL.md
  "name": "digital-quest",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/z/*"]
  },
  // EIGENE D1-Datenbank (nicht die von SPS Quest), angelegt am 29.09.2026 (Region EEUR).
  // Tabellen legt der Code selbst an (worker/db.js, Migrationen laufen beim ersten Aufruf).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digitalquest",
      "database_id": "04e24744-b4ae-4d58-a6bf-0e5b0e71e94a"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (nicht in dieser Datei!): npx wrangler secret put ADMIN_USER / ADMIN_PASSWORD – im Projektordner ausfuehren
}
